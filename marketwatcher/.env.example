# Copy this file to .env for local development only.
# Never commit the real .env file.

DB_URL=jdbc:mariadb://localhost:3309/webdb
DB_USERNAME=webuser
DB_PASSWORD=replace-with-local-database-password

KAKAO_CLIENT_ID=replace-with-kakao-client-id
KAKAO_CLIENT_SECRET=replace-with-newly-rotated-kakao-client-secret

# Generate a long random value. Do not reuse this example text in production.
REMEMBER_ME_KEY=replace-with-at-least-32-random-bytes

UPLOAD_PATH=C:/Users/user/upload
